{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {},
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git worktree *)",
      "Bash(git wt *)",
      "Bash(git wt-rm *)",
      "Bash(open *)"
    ],
    "deny": [
      "Edit(**/.git/**)",
      "Read(**/.credentials.json)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/.env)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/credentials.json)",
      "Read(**/credentials)",
      "Read(**/id_ed25519*)",
      "Read(**/id_rsa*)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/sso/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.ssh/*)"
    ],
    "ask": [
      "Bash(cdk bootstrap*)",
      "Bash(cdk deploy*)",
      "Bash(cdk destroy*)",
      "Bash(docker push*)",
      "Bash(gh api*)",
      "Bash(gh gist create*)",
      "Bash(git push*)",
      "Bash(glab api*)",
      "Bash(glab snippet create*)",
      "Bash(npm publish*)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(sam delete*)",
      "Bash(sam deploy*)",
      "Bash(sam sync*)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(terraform import*)",
      "Bash(terraform state mv*)",
      "Bash(terraform state push*)",
      "Bash(terraform state rm*)",
      "Edit(**/*settings*.json)",
      "Edit(**/CLAUDE.md)",
      "Edit(**/hooks/**)",
      "Edit(**/policy.conf)",
      "Edit(**/terminator.sh)",
      "Edit(**/wrappers/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/nicholas.ferrara/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/nicholas.ferrara/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/nicholas.ferrara/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/projects/setup/linked/claude/hooks/pre-commit-format.sh"
          },
          {
            "type": "command",
            "command": "~/projects/setup/linked/claude/hooks/validate-command.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/nicholas.ferrara/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/nicholas.ferrara/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/nicholas.ferrara/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/nicholas.ferrara/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/nicholas.ferrara/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/nicholas.ferrara/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/nicholas.ferrara/.config/iterm2/cc-status"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "~/projects/setup/linked/claude/statusline.sh",
    "refreshInterval": 10
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowedDomains": [
        "*.amazonaws.com",
        "*.github.com",
        "auth.docker.io",
        "code.claude.com",
        "codeload.github.com",
        "docs.anthropic.com",
        "docs.aws.amazon.com",
        "docs.claude.com",
        "files.pythonhosted.org",
        "formulae.brew.sh",
        "ghcr.io",
        "github.com",
        "gitlab.com",
        "json.schemastore.org",
        "objects.githubusercontent.com",
        "plugins.dprint.dev",
        "production.cloudflare.docker.com",
        "pypi.org",
        "raw.githubusercontent.com",
        "registry-1.docker.io",
        "registry.npmjs.org",
        "registry.terraform.io",
        "releases.hashicorp.com",
        "www.schemastore.org"
      ],
      "allowUnixSockets": [
        "~/.gnupg/S.gpg-agent"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "/tmp",
        "~/.Trash",
        "~/.cache",
        "~/.gnupg",
        "~/Library/Application Support/glab-cli",
        "~/Library/Caches",
        "~/projects",
        "~/work"
      ],
      "denyWrite": [
        "~/projects/setup/linked/claude/hooks",
        "~/projects/setup/linked/claude/wrappers",
        "~/projects/setup/linked/claude/policy.conf",
        "~/projects/setup/linked/claude/statusline.sh",
        "~/projects/setup/linked/claude/terminator.sh",
        "~/projects/setup/linked/claude/claude-aws.sh",
        "~/projects/setup/linked/git_functions.sh"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.aws/credentials",
          "mode": "deny"
        },
        {
          "path": "~/.aws/sso",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh",
          "mode": "deny"
        },
        {
          "path": "~/.netrc",
          "mode": "deny"
        },
        {
          "path": "~/.npmrc",
          "mode": "deny"
        },
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "**/*.key",
          "mode": "deny"
        },
        {
          "path": "**/*.pem",
          "mode": "deny"
        },
        {
          "path": "**/id_ed25519*",
          "mode": "deny"
        },
        {
          "path": "**/id_rsa*",
          "mode": "deny"
        },
        {
          "path": "**/.env",
          "mode": "deny"
        },
        {
          "path": "**/.env.local",
          "mode": "deny"
        },
        {
          "path": "**/.env.*.local",
          "mode": "deny"
        },
        {
          "path": "**/.env.development",
          "mode": "deny"
        },
        {
          "path": "**/.env.production",
          "mode": "deny"
        },
        {
          "path": "**/.env.staging",
          "mode": "deny"
        },
        {
          "path": "**/.env.test",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "CLOUDSDK_PROXY_PASSWORD",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITLAB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GLAB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "allowAppleEvents": true,
    "excludedCommands": [
      "git *"
    ]
  },
  "tui": "fullscreen",
  "autoMode": {
    "environment": [
      "$defaults",
      "This machine normally has substantial uncommitted work in ~/work and ~/projects. Treat anything that discards uncommitted changes as high-risk even when it looks routine.",
      "~/projects/setup is the configuration repo for this machine. Changes to its linked/claude tree alter the permissions, hooks and sandbox that govern this session."
    ],
    "classifyAllShell": true
  }
}
